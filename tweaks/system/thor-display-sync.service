[Unit]
Description=Thor Dual-Screen Display Sleep & Idle Sync Daemon
After=armada-control.service gamescope-session-plus@steam.service armada-bottom-gamescope.service
Wants=armada-bottom-gamescope.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/local/bin/thor-display-sync
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

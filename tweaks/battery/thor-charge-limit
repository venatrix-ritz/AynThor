#!/bin/bash
# thor-charge-limit: 80% battery ceiling protection for AYN Thor.
# Sets PMIC firmware threshold via charge_control_end_threshold, and if supported,
# clamps charge current via charge_control_limit.
set -euo pipefail
B="/sys/class/power_supply/battery"
U="/sys/class/power_supply/qcom-battmgr-usb"
THR="$B/charge_control_end_threshold"
LIM="$B/charge_control_limit"
MAX="$B/charge_control_limit_max"

log(){ logger -t thor-charge-limit -- "$*"; }

for i in $(seq 1 30); do
    [ -e "$B/capacity" ] && [ -e "$U/online" ] && break
    sleep 1
done

# 1. Apply hardware firmware threshold (standard Linux power_supply attribute)
applied_threshold=0
if [ -e "$THR" ]; then
    if echo 80 > "$THR" 2>/dev/null; then
        applied_threshold=1
        log "firmware charge_control_end_threshold set to 80 (readback=$(cat "$THR" 2>/dev/null || echo '?'))"
    fi
fi

# 2. Check for optional charge_control_limit current clamping
if [ ! -e "$LIM" ]; then
    if [ "$applied_threshold" -eq 1 ]; then
        log "Hardware charge_control_end_threshold active. Current-limit node absent on this kernel; sleeping."
        # Sleep indefinitely while keeping the service active to maintain the state
        exec sleep infinity
    else
        log "Neither charge_control_end_threshold nor charge_control_limit found; exiting."
        exit 0
    fi
fi

maxv=$(cat "$MAX" 2>/dev/null || echo 9000000)
state=released

release(){
    echo "$maxv" > "$LIM" 2>/dev/null && state=released && log "Released charge limit (max=$maxv) cap=$(cat $B/capacity 2>/dev/null || echo 0)"
}

clamp(){
    echo 1000 > "$LIM" 2>/dev/null && state=clamped && log "Clamped charge limit at 80% cap=$(cat $B/capacity 2>/dev/null || echo 0)"
}

trap 'release; exit 0' TERM INT

cap=$(cat "$B/capacity" 2>/dev/null || echo 0)
on=$(cat "$U/online" 2>/dev/null || echo 0)
if [ "$on" = 1 ] && [ "$cap" -ge 80 ]; then
    clamp
else
    release
fi

while sleep 30; do
    cap=$(cat "$B/capacity" 2>/dev/null) || continue
    on=$(cat "$U/online" 2>/dev/null) || continue
    if [ "$state" = released ] && [ "$on" = 1 ] && [ "$cap" -ge 80 ]; then
        clamp
    elif [ "$state" = clamped ] && { [ "$on" != 1 ] || [ "$cap" -le 77 ]; }; then
        release
    fi
done

[Unit]
Description=Thor 80% Battery Charge Ceiling Protection
After=multi-user.target

[Service]
Type=simple
ExecStart=/var/local/bin/thor-charge-limit
# Safety net on stop: if the limit was left clamped (script killed), put it back to the node's maximum. A value above the clamp is the firmware's own and is left alone.
ExecStopPost=/bin/sh -c 'B=/sys/class/power_supply/battery; echo 0 > $$B/charge_control_end_threshold 2>/dev/null; for n in charge_control_limit constant_charge_current; do [ -e $$B/$$n ] || continue; c=$$(cat $$B/$$n 2>/dev/null || echo 0); if [ "$$c" -le 1000 ]; then m=$$(cat $$B/$${n}_max 2>/dev/null || echo 9000000); echo $$m > $$B/$$n 2>/dev/null; fi; done; true'
# Exit 78 = no usable limit on this kernel: stay failed and visible instead of looping.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
